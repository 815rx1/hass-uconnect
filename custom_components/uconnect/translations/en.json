{
    "title": "Uconnect",
    "config": {
        "step": {
            "user": {
                "title": "API Authentication",
                "description": "Set up your Uconnect-enabled vehicle to integrate with Home Assistant.",
                "data": {
                    "username": "Username",
                    "password": "Password",
                    "brand_region": "Brand + Region",
                    "pin": "Pin",
                    "disable_tls_verification": "Disable TLS certificate verification"
                }
            },
            "reauth_confirm": {
                "title": "Reauthenticate Uconnect",
                "description": "The Uconnect servers rejected the stored password for {username}. Enter the current password. Leave the PIN empty to keep the stored one.",
                "data": {
                    "password": "Password",
                    "pin": "PIN"
                }
            },
            "reconfigure": {
                "title": "Reconfigure Uconnect",
                "description": "Update the login of {username}. Leave the PIN empty to keep the stored one.",
                "data": {
                    "password": "Password",
                    "pin": "PIN",
                    "disable_tls_verification": "Disable TLS certificate verification"
                }
            }
        },
        "abort": {
            "already_configured": "Device is already configured",
            "reauth_successful": "Re-authentication was successful",
            "reconfigure_successful": "Reconfiguration was successful"
        },
        "error": {
            "invalid_auth": "The login failed to the Uconnect servers. Double check your vehicle doesn't use SiriusXM Guardian and your credentials are correct.",
            "unknown": "Unexpected error",
            "cannot_connect": "Unable to reach the Uconnect servers. Try again later."
        }
    },
    "options": {
        "step": {
            "init": {
                "title": "API Configuration",
                "data": {
                    "scan_interval": "Scan Interval (min)",
                    "pin": "Pin",
                    "charging_refresh_interval": "Deep Refresh While Charging (min, 0 = no automatic wake-ups, 15 minimum)",
                    "add_command_entities": "Add command entities (Button/Lock/Switch)",
                    "unlock_requires_pin": "Require the Uconnect PIN to unlock"
                }
            }
        }
    },
