                "thursday": "Thursday",
                "friday": "Friday",
                "saturday": "Saturday",
                "sunday": "Sunday"
            }
        }
    },
    "exceptions": {
        "refresh_cooldown": {
            "message": "Not sent: the vehicle was refreshed shortly before. Try again in {minutes} min."
        },
        "refresh_daily_limit": {
            "message": "Not sent: the daily limit for refreshes requested by hand is reached. Try again in {minutes} min."
        },
        "repeated_command": {
            "message": "Not sent: {command} was confirmed by the vehicle less than a minute ago."
        },
        "hourly_limit": {
            "message": "Not sent: more commands than a person sends within an hour, which looks like an automation stuck in a loop. Try again in {minutes} min."
        },
        "unlock_code_required": {
            "message": "Unlocking needs the Uconnect PIN as the code. The requirement can be turned off in the integration options."
        },
        "unlock_code_wrong": {
            "message": "The code is not the Uconnect PIN."
        },
        "unlock_locked_out": {
            "message": "Unlocking is paused for {minutes} min after several wrong codes."
        }
